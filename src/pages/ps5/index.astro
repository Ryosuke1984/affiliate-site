---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const ps5Articles = allArticles.filter((a) => a.data.platform === 'ps5');
---

<BaseLayout title="PS5 記事一覧 | ゲームハードナビ" platform="ps5">
  <div class="card">
    <h1>PS5 記事一覧</h1>
  </div>
  <div class="card">
    <ul>
      {ps5Articles.map((article) => (
        <li><a href={`/articles/${article.id}`}>{article.data.title}</a></li>
      ))}
    </ul>
  </div>
</BaseLayout>
